{
  "name": "@morphql/store",
  "version": "0.1.43",
  "description": "In-memory and persistent data store for morphql with SQL-like query support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format cjs,esm --dts --clean",
    "test": "vitest run"
  },
  "keywords": [
    "morphql",
    "store",
    "database",
    "in-memory",
    "sql"
  ],
  "author": "Hyperwindmill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperwindmill/morphql.git",
    "directory": "packages/store"
  },
  "bugs": {
    "url": "https://github.com/Hyperwindmill/morphql/issues"
  },
  "homepage": "https://github.com/Hyperwindmill/morphql/tree/main/packages/store#readme",
  "dependencies": {
    "@morphql/core": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
